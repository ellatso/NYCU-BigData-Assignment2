digraph schema {
graph [rankdir=LR, bgcolor="#fcfcfb", nodesep=0.35, ranksep=1.1, fontname="DejaVu Sans", pad=0.2];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="DejaVu Sans", fontsize=9, fontcolor="#52514e"];
Users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#cde2fb" port="title"><b>Users</b><br/><font point-size="9" color="#52514e">10,140 rows · row time: first_seen_at</font></td></tr><tr><td align="left" port="pk"><u><b>user_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr></table>>];
Repositories [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#cde2fb" port="title"><b>Repositories</b><br/><font point-size="9" color="#52514e">20,197 rows · row time: first_seen_at</font></td></tr><tr><td align="left" port="pk"><u><b>repo_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr></table>>];
PullRequests [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>PullRequests</b><br/><font point-size="9" color="#52514e">41,461 rows · row time: first_seen_at</font></td></tr><tr><td align="left" port="pk"><u><b>pr_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr><tr><td align="left" port="author_id">author_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr><tr><td align="left" port="merged_by_id">merged_by_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr></table>>];
Issues [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>Issues</b><br/><font point-size="9" color="#52514e">26,956 rows · row time: first_seen_at</font></td></tr><tr><td align="left" port="pk"><u><b>issue_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr><tr><td align="left" port="author_id">author_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr><tr><td align="left" port="assignee_id">assignee_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr><tr><td align="left" port="pull_request_id">pull_request_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → PullRequests</font></td></tr></table>>];
IssueComments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>IssueComments</b><br/><font point-size="9" color="#52514e">15,245 rows · row time: created_at</font></td></tr><tr><td align="left" port="pk"><u><b>comment_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="issue_id">issue_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Issues</font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr><tr><td align="left" port="author_id">author_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr></table>>];
PRReviews [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>PRReviews</b><br/><font point-size="9" color="#52514e">12,524 rows · row time: first_seen_at</font></td></tr><tr><td align="left" port="pk"><u><b>review_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="pr_id">pr_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → PullRequests</font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr><tr><td align="left" port="reviewer_id">reviewer_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr></table>>];
PRReviewComments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>PRReviewComments</b><br/><font point-size="9" color="#52514e">9,999 rows · row time: created_at</font></td></tr><tr><td align="left" port="pk"><u><b>comment_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="pr_id">pr_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → PullRequests</font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr><tr><td align="left" port="author_id">author_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr><tr><td align="left" port="pull_request_review_id">pull_request_review_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → PRReviews</font></td></tr><tr><td align="left" port="in_reply_to_id">in_reply_to_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → PRReviewComments</font></td></tr></table>>];
Pushes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#c3c2b7" bgcolor="#ffffff"><tr><td bgcolor="#e8e7e2" port="title"><b>Pushes</b><br/><font point-size="9" color="#52514e">88,781 rows · row time: created_at</font></td></tr><tr><td align="left" port="pk"><u><b>push_id</b></u>  <font color="#2a78d6"><b>PK</b></font></td></tr><tr><td align="left" port="user_id">user_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Users</font></td></tr><tr><td align="left" port="repo_id">repo_id  <font color="#eb6834"><b>FK</b></font><font point-size="9" color="#898781"> → Repositories</font></td></tr></table>>];
PullRequests:repo_id:e -> Repositories:pk:w [color="#898781"];
PullRequests:author_id:e -> Users:pk:w [color="#2a78d6"];
PullRequests:merged_by_id:e -> Users:pk:w [color="#2a78d6"];
Issues:repo_id:e -> Repositories:pk:w [color="#898781"];
Issues:author_id:e -> Users:pk:w [color="#2a78d6"];
Issues:assignee_id:e -> Users:pk:w [color="#2a78d6"];
Issues:pull_request_id:e -> PullRequests:pk:w [color="#eb6834"];
IssueComments:issue_id:e -> Issues:pk:w [color="#eb6834"];
IssueComments:repo_id:e -> Repositories:pk:w [color="#898781"];
IssueComments:author_id:e -> Users:pk:w [color="#2a78d6"];
PRReviews:pr_id:e -> PullRequests:pk:w [color="#eb6834"];
PRReviews:repo_id:e -> Repositories:pk:w [color="#898781"];
PRReviews:reviewer_id:e -> Users:pk:w [color="#2a78d6"];
PRReviewComments:pr_id:e -> PullRequests:pk:w [color="#eb6834"];
PRReviewComments:repo_id:e -> Repositories:pk:w [color="#898781"];
PRReviewComments:author_id:e -> Users:pk:w [color="#2a78d6"];
PRReviewComments:pull_request_review_id:e -> PRReviews:pk:w [color="#eb6834"];
PRReviewComments:in_reply_to_id:e -> PRReviewComments:pk:e [constraint=false, color="#eb6834"];
Pushes:user_id:e -> Users:pk:w [color="#2a78d6"];
Pushes:repo_id:e -> Repositories:pk:w [color="#898781"];
{rank=same; Users; Repositories;}
{rank=same; IssueComments; PRReviewComments; Pushes;}
legend [label=<<table border="0" cellspacing="2"><tr><td align="left"><font color="#2a78d6"><b>&#8594;</b></font> FK to Users</td></tr><tr><td align="left"><font color="#898781"><b>&#8594;</b></font> FK to Repositories</td></tr><tr><td align="left"><font color="#eb6834"><b>&#8594;</b></font> FK between activity tables</td></tr><tr><td align="left"><font point-size="9" color="#52514e">8 tables · 20 foreign keys · edge = FK &#8594; referenced PK</font></td></tr></table>>];
}